/* LumiSync — Fluent (WinUI 3) dark theme. {token} placeholders are
   substituted at load time from tokens.py. Layering comes from translucent
   fills (fl_card / fl_control) over one window layer; borders stay subtle.
   Controls are 4px round, cards and flyouts 8px. FluentStyle (Python) adds
   what QSS cannot: combo-box flyouts, translucent menus, focus rings. */

/* ------------------------------------------------------------------ base */

QWidget {
    background: transparent;
    color: {fl_text};
    font-family: "Segoe UI Variable Text", "Segoe UI Variable", "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}

QWidget:disabled {
    color: {fl_text_disabled};
}

/* Solid fallback canvas (non-Windows, older Windows, or the Solid material). */
QMainWindow,
QDialog {
    background: {bg};
}

/* The rail and the content share one layer, as in WinUI's NavigationView. */
QStackedWidget#ContentStack,
QFrame#Sidebar {
    background: {bg};
    border: none;
}

QStackedWidget,
QStackedWidget > QWidget,
QStackedWidget#ContentStack > QWidget {
    background: transparent;
}

/* Windows 11 backdrops are enabled only after DWM accepts the request. */
QMainWindow[backdrop="mica"],
QMainWindow[backdrop="acrylic"] {
    background: transparent;
}

QMainWindow[backdrop="mica"] QStackedWidget#ContentStack,
QMainWindow[backdrop="mica"] QFrame#Sidebar {
    background: {mica_bg};
}

QMainWindow[backdrop="acrylic"] QStackedWidget#ContentStack,
QMainWindow[backdrop="acrylic"] QFrame#Sidebar {
    background: {acrylic_bg};
}

QMainWindow[backdrop="mica"] QFrame#DeviceInspector {
    background: {mica_inspector_surface};
}

QMainWindow[backdrop="acrylic"] QFrame#DeviceInspector {
    background: {acrylic_inspector_surface};
}

QAbstractScrollArea > QWidget,
QScrollArea,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel,
QCheckBox,
QRadioButton,
QToolButton {
    background: transparent;
}

/* ------------------------------------------------------------ typography */

QLabel[role="title"],
QLabel[role="header"] {
    font-family: "Segoe UI Variable Display Semibold", "Segoe UI Semibold", "Segoe UI";
    font-size: {font_title};
    font-weight: 600;
    color: {fl_text};
    padding: 0;
}

QLabel[role="header"] {
    font-size: 20px;
}

QLabel[role="pageDescription"] {
    color: {fl_text_secondary};
    font-size: 14px;
}

QLabel[role="subtle"],
QLabel[role="status"],
QLabel[role="autoDirectorMeta"],
QLabel[role="settingsDescription"] {
    color: {fl_text_secondary};
    font-size: 12px;
}

QLabel[role="strong"],
QLabel[role="sectionLabel"],
QLabel[role="autoDirectorTitle"],
QLabel[role="rowTitle"] {
    font-family: "Segoe UI Variable Text Semibold", "Segoe UI Semibold", "Segoe UI";
    font-weight: 600;
    color: {fl_text};
}

QLabel[role="sectionTitle"],
QLabel[role="groupHeader"] {
    font-family: "Segoe UI Variable Text Semibold", "Segoe UI Semibold", "Segoe UI";
    font-size: 14px;
    font-weight: 600;
    color: {fl_text};
}

QLabel[role="settingsTitle"] {
    font-size: 14px;
    color: {fl_text};
}

QLabel[role="valueLabel"] {
    font-size: 14px;
    color: {fl_text_secondary};
}

QLabel[role="fieldLabel"] {
    color: {fl_text_secondary};
    font-size: 12px;
}

QLabel[role="link"] {
    color: {fl_accent_text};
    font-size: 12px;
}

QLabel[role="eyebrow"] {
    color: {fl_text_tertiary};
    font-family: "Segoe UI Variable Text Semibold", "Segoe UI Semibold", "Segoe UI";
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="inspectorTitle"] {
    font-family: "Segoe UI Variable Display Semibold", "Segoe UI Semibold", "Segoe UI";
    color: {fl_text};
    font-size: 20px;
    font-weight: 600;
}

QLabel[role="hint"],
QLabel[disabledHint="true"] {
    color: {fl_text_tertiary};
    font-size: 12px;
}

QLabel[role="status"][statusState="online"] {
    color: {success};
}

QLabel[role="status"][statusState="warning"],
QLabel[role="warn"] {
    color: {warning};
}

QLabel[role="warn"] {
    font-size: 12px;
}

QLabel[role="status"][statusState="offline"] {
    color: {fl_text_secondary};
}

/* One merged status phrase on device cards and the inspector. The dot
   beside it carries the state colour; the text stays readable. */
QLabel[role="deviceStatus"] {
    color: {fl_text};
    font-size: 12px;
}

QLabel[role="deviceStatus"][statusState="warning"] {
    color: {warning};
}

QLabel[role="deviceStatus"][statusState="offline"],
QLabel[role="deviceStatus"][statusState="unknown"] {
    color: {fl_text_secondary};
}

QLabel[role="icon"] {
    color: {fl_text_secondary};
}

QLabel[role="empty"] {
    color: {fl_text_secondary};
    font-size: 14px;
    padding: 40px;
}

QLabel[role="pill"] {
    background: {fl_subtle_selected};
    color: {fl_text};
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 12px;
}

QLabel[state="active"] {
    color: {success};
}

QLabel[state="idle"],
QLabel[state="inactive"] {
    color: {fl_text_secondary};
}

QLabel[state="error"] {
    color: {danger};
}

/* ----------------------------------------------------------------- cards */

QGroupBox {
    background: {fl_card};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
    margin-top: 28px;
    padding: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 0;
    padding: 0;
    color: {fl_text};
    font-family: "Segoe UI Variable Text Semibold", "Segoe UI Semibold", "Segoe UI";
    font-weight: 600;
    font-size: 14px;
}

QFrame[card="true"],
QFrame#SettingsCard,
QFrame#SettingsList,
QFrame#InspectorSection,
QFrame#ActiveSyncRow,
QFrame#DrawToolsPanel,
QFrame#DrawCanvasPanel,
QFrame#DrawTimelinePanel,
QFrame#AccountSignInPanel,
QFrame#EnergyReadings,
QFrame#EnergyHistory {
    background: {fl_card};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
}

QFrame[card="true"][hovered="true"],
QFrame#SettingsCard[clickable="true"]:hover {
    background: {fl_card_hover};
}

QFrame[card="true"][selected="true"] {
    border-color: {fl_accent};
}

/* Rows inside a grouped list share the list's surface and are separated by
   hairline dividers, like WinUI's settings lists. */
QFrame#SettingsRow {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#SettingsRow[clickable="true"]:hover {
    background: {fl_subtle_hover};
}

QFrame#SettingsRow[position="first"] {
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

QFrame#SettingsRow[position="last"] {
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

QFrame#SettingsRow[position="only"] {
    border-radius: 7px;
}

QFrame#SettingsDivider,
QFrame#SectionDivider {
    background: {fl_divider};
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#SettingsExpanderBody {
    background: transparent;
    border: none;
    border-top: 1px solid {fl_divider};
}

/* Device tiles: the Fluent card contract shared with the Devices page. */
QFrame#DeviceCard {
    background: {fl_card};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
}

QFrame#DeviceCard[hovered="true"] {
    background: {fl_card_hover};
}

QFrame#DeviceCard:focus {
    border-color: rgba(255, 255, 255, 0.36);
}

QFrame#DeviceCard[inspected="true"] {
    border-color: {fl_accent};
}

QToolButton#DevicePowerButton {
    background: {fl_control};
    border: 1px solid {fl_control_stroke};
    border-top-color: {fl_control_stroke_top};
    border-radius: 20px;
    padding: 0;
}

QToolButton#DevicePowerButton:hover {
    background: {fl_control_hover};
}

QToolButton#DevicePowerButton:pressed {
    background: {fl_control_pressed};
}

QToolButton#DevicePowerButton[powerState="on"] {
    background: {fl_accent};
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

QToolButton#DevicePowerButton[powerState="on"]:hover {
    background: {fl_accent_hover};
}

QToolButton#DevicePowerButton[powerState="on"]:pressed {
    background: {fl_accent_pressed};
}

QToolButton#DevicePowerButton[powerState="offline"] {
    background: {fl_control_disabled};
    border-color: transparent;
}

QToolButton#DevicePowerButton:disabled {
    background: {fl_control_disabled};
    border-color: transparent;
}

QScrollArea#DeviceInspectorScroll {
    background: transparent;
    border: none;
}

QFrame#DeviceInspector {
    background: {surface};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
}

QToolButton#InspectorCloseButton,
QToolButton[role="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: {fl_text_secondary};
    padding: 0;
}

QToolButton#InspectorCloseButton {
    font-size: 16px;
}

QToolButton[role="ghost"] {
    min-width: 36px;
    min-height: 36px;
}

QToolButton#InspectorCloseButton:hover,
QToolButton[role="ghost"]:hover {
    background: {fl_subtle_hover};
    color: {fl_text};
}

QToolButton#InspectorCloseButton:pressed,
QToolButton[role="ghost"]:pressed {
    background: {fl_control_pressed};
    color: {fl_text_secondary};
}

QToolButton[role="link"] {
    background: transparent;
    border: none;
    color: {fl_accent_text};
    padding: 2px 4px;
    font-size: 12px;
}

QToolButton[role="link"]:hover {
    color: {fl_accent_hover};
}

/* --------------------------------------------------------------- buttons */

QPushButton,
QToolButton[role="button"] {
    background: {fl_control};
    color: {fl_text};
    border: 1px solid {fl_control_stroke};
    border-top-color: {fl_control_stroke_top};
    border-radius: 4px;
    padding: 0 12px;
    min-height: 30px;
}

QPushButton:hover,
QToolButton[role="button"]:hover {
    background: {fl_control_hover};
}

QPushButton:pressed,
QPushButton:checked:pressed,
QToolButton[role="button"]:pressed {
    background: {fl_control_pressed};
    color: {fl_text_secondary};
    border-top-color: {fl_control_stroke};
}

QPushButton:disabled,
QToolButton[role="button"]:disabled {
    background: {fl_control_disabled};
    color: {fl_text_disabled};
    border-color: {fl_control_stroke};
}

/* A latched toggle button (Test colours, Animation) reads as accent. */
QPushButton:checked {
    background: {fl_accent};
    color: {fl_accent_on};
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

QPushButton:checked:hover {
    background: {fl_accent_hover};
}

QPushButton#Primary,
QPushButton[role="primary"],
QMessageBox QPushButton:default,
QInputDialog QPushButton:default {
    background: {fl_accent};
    color: {fl_accent_on};
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

QPushButton#Primary:hover,
QPushButton[role="primary"]:hover,
QMessageBox QPushButton:default:hover,
QInputDialog QPushButton:default:hover {
    background: {fl_accent_hover};
}

QPushButton#Primary:pressed,
QPushButton[role="primary"]:pressed,
QMessageBox QPushButton:default:pressed,
QInputDialog QPushButton:default:pressed {
    background: {fl_accent_pressed};
    color: rgba(8, 16, 31, 0.62);
}

QPushButton#Primary:disabled,
QPushButton[role="primary"]:disabled {
    background: rgba(255, 255, 255, 0.159);
    color: rgba(255, 255, 255, 0.53);
    border-color: transparent;
}

QPushButton#DangerButton,
QPushButton[role="danger"] {
    background: {danger};
    color: #200A0D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

QPushButton#DangerButton:hover,
QPushButton[role="danger"]:hover {
    background: {danger_bright};
}

QPushButton#DangerButton:pressed,
QPushButton[role="danger"]:pressed {
    background: #E88A94;
    color: rgba(32, 10, 13, 0.62);
}

QPushButton#DangerButton:disabled,
QPushButton[role="danger"]:disabled {
    background: rgba(255, 255, 255, 0.159);
    color: rgba(255, 255, 255, 0.53);
    border-color: transparent;
}

QDialogButtonBox QPushButton,
QMessageBox QPushButton {
    min-width: 72px;
}

/* Subtle buttons: no fill until hovered. */
QPushButton[role="ghost"],
QPushButton[role="subtle"],
QPushButton#SectionToggle {
    background: transparent;
    border: 1px solid transparent;
    color: {fl_text};
}

QPushButton[role="ghost"]:hover,
QPushButton[role="subtle"]:hover,
QPushButton#SectionToggle:hover {
    background: {fl_subtle_hover};
}

QPushButton[role="ghost"]:pressed,
QPushButton[role="subtle"]:pressed,
QPushButton#SectionToggle:pressed {
    background: {fl_control_pressed};
    color: {fl_text_secondary};
}

QPushButton#SectionToggle {
    text-align: left;
    padding: 0 8px;
    font-family: "Segoe UI Variable Text Semibold", "Segoe UI Semibold", "Segoe UI";
    font-weight: 600;
}

/* HyperlinkButton */
QPushButton#LinkButton {
    background: transparent;
    border: 1px solid transparent;
    color: {fl_accent_text};
    text-align: left;
    padding: 0 8px;
    min-height: 30px;
}

QPushButton#LinkButton:hover {
    background: {fl_subtle_hover};
    color: {fl_accent_text};
}

QPushButton#LinkButton:pressed {
    background: {fl_control_pressed};
    color: {fl_accent_pressed};
}

QPushButton#LinkButton:disabled {
    background: transparent;
    color: {fl_text_disabled};
}

QPushButton#DisclosureButton {
    padding: 0 12px;
}

QPushButton#ColorSwatch {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    padding: 0;
}

QPushButton#ColorSwatch:hover {
    border-color: rgba(255, 255, 255, 0.40);
}

/* Fluent toggle tiles (Music reaction styles). */
QPushButton[reactionOption="true"] {
    padding: 0 12px;
    color: {fl_text};
    text-align: center;
}

QPushButton[reactionOption="true"]:checked {
    background: {fl_accent};
    color: {fl_accent_on};
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

QPushButton[reactionOption="true"]:checked:hover {
    background: {fl_accent_hover};
}

/* Auto Director is playing this style right now: a quiet accent outline. */
QPushButton[reactionOption="true"][autoActive="true"] {
    border: 1px solid {fl_accent};
    color: {fl_accent_text};
}

/* Legacy target chips (kept for any external caller). */
QPushButton[chip="true"] {
    border-radius: 4px;
    padding: 0 10px;
    font-size: 12px;
}

QPushButton[chip="true"][active="true"] {
    background: {fl_subtle_selected};
    border-color: {fl_accent};
}

/* --------------------------------------------------------------- inputs */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit {
    background: {fl_control};
    color: {fl_text};
    border: 1px solid {fl_control_stroke};
    border-bottom: 1px solid {fl_control_strong};
    border-radius: 4px;
    padding: 0 10px 1px 10px;
    min-height: 29px;
    selection-background-color: {fl_accent};
    selection-color: {fl_accent_on};
    placeholder-text-color: {fl_text_tertiary};
}

QPlainTextEdit,
QTextEdit {
    padding: 6px 8px 7px 8px;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    background: {fl_control_hover};
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    background: rgba(30, 30, 30, 0.70);
    border-bottom: 2px solid {fl_accent};
    padding-bottom: 0;
}

QPlainTextEdit:focus,
QTextEdit:focus {
    padding-bottom: 6px;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background: {fl_control_disabled};
    color: {fl_text_disabled};
    border-bottom-color: {fl_control_stroke};
}

QLineEdit[readOnly="true"] {
    background: transparent;
    border-color: transparent;
}

QSpinBox,
QDoubleSpinBox {
    padding-right: 28px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 24px;
    border: none;
    background: transparent;
    border-radius: 3px;
    margin: 2px 3px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: {fl_subtle_hover};
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url({icon_dir}/fluent-chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url({icon_dir}/fluent-chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* -------------------------------------------------------------- combo box
   The flyout and its rows are drawn by FluentStyle / FluentComboDelegate. */

QComboBox {
    background: {fl_control};
    color: {fl_text};
    border: 1px solid {fl_control_stroke};
    border-top-color: {fl_control_stroke_top};
    border-radius: 4px;
    padding: 0 32px 0 11px;
    min-height: 30px;
    selection-background-color: {fl_subtle_selected};
    selection-color: {fl_text};
}

QComboBox:hover {
    background: {fl_control_hover};
}

QComboBox:on {
    background: {fl_control_pressed};
    color: {fl_text_secondary};
}

QComboBox:disabled {
    background: {fl_control_disabled};
    color: {fl_text_disabled};
}

QComboBox:editable {
    border-bottom: 1px solid {fl_control_strong};
}

QComboBox:editable:focus {
    background: rgba(30, 30, 30, 0.70);
    border-bottom: 2px solid {fl_accent};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url({icon_dir}/fluent-chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url({icon_dir}/fluent-chevron-down-disabled.svg);
}

QComboBox::down-arrow:on {
    top: 1px;
}

/* ---------------------------------------------------------- check / radio */

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: {fl_text};
    min-height: 32px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid {fl_control_strong};
    background: rgba(0, 0, 0, 0.10);
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    background: rgba(255, 255, 255, 0.06);
}

QCheckBox::indicator:checked,
QCheckBox::indicator:indeterminate {
    background: {fl_accent};
    border-color: {fl_accent};
    image: url({icon_dir}/fluent-check.svg);
}

QCheckBox::indicator:checked:hover {
    background: {fl_accent_hover};
    border-color: {fl_accent_hover};
}

QRadioButton::indicator:checked {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 {fl_accent_on}, stop: 0.42 {fl_accent_on}, stop: 0.46 {fl_accent}, stop: 1 {fl_accent});
    border-color: {fl_accent};
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border-color: rgba(255, 255, 255, 0.16);
    background: transparent;
}

QCheckBox::indicator:checked:disabled {
    background: rgba(255, 255, 255, 0.159);
    image: url({icon_dir}/fluent-check-disabled.svg);
}

/* --------------------------------------------------------------- sliders
   ProductSlider paints itself; this approximates it for plain QSlider. */

QSlider {
    min-height: 32px;
    background: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: {fl_control_strong};
    border: none;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: {fl_accent};
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: {fl_control_strong};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -8px 0;
    border-radius: 10px;
    border: 1px solid {fl_control_stroke};
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 {fl_accent}, stop: 0.58 {fl_accent}, stop: 0.62 {fl_control_solid}, stop: 1 {fl_control_solid});
}

QSlider::handle:horizontal:hover {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 {fl_accent_hover}, stop: 0.68 {fl_accent_hover}, stop: 0.72 {fl_control_solid}, stop: 1 {fl_control_solid});
}

QSlider::handle:horizontal:pressed {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 {fl_accent_pressed}, stop: 0.48 {fl_accent_pressed}, stop: 0.52 {fl_control_solid}, stop: 1 {fl_control_solid});
}

QSlider::sub-page:horizontal:disabled,
QSlider::groove:horizontal:disabled,
QSlider::add-page:horizontal:disabled {
    background: rgba(255, 255, 255, 0.159);
}

QSlider::handle:horizontal:disabled {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #5D5D5D, stop: 0.58 #5D5D5D, stop: 0.62 {fl_control_solid}, stop: 1 {fl_control_solid});
}

/* ---------------------------------------------------------- progress bar */

QProgressBar {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
    color: transparent;
    text-align: center;
}

QProgressBar::chunk {
    background: {fl_accent};
    border-radius: 2px;
}

QProgressDialog QProgressBar {
    margin: 8px 0;
}

/* ----------------------------------------------------------- list / table */

QListWidget,
QListView,
QTreeView,
QTableView {
    background: {fl_card};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: {fl_subtle_selected};
    selection-color: {fl_text};
}

QListWidget::item,
QListView::item {
    padding: 6px 10px;
    border-radius: 4px;
    margin: 1px 0;
}

QListWidget::item:hover,
QListView::item:hover {
    background: {fl_subtle_hover};
}

QListWidget::item:selected,
QListView::item:selected {
    background: {fl_subtle_selected};
    color: {fl_text};
}

/* The rail is painted by its delegate. */
QListWidget#SidebarNav,
QListWidget#SidebarNavBottom {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#SidebarNav::item,
QListWidget#SidebarNavBottom::item,
QListWidget#SidebarNav::item:selected,
QListWidget#SidebarNavBottom::item:selected,
QListWidget#SidebarNav::item:hover,
QListWidget#SidebarNavBottom::item:hover {
    padding: 0;
    margin: 0;
    background: transparent;
}

QLabel#SidebarTitle {
    color: {fl_text};
    font-size: 14px;
}

QHeaderView::section {
    background: transparent;
    color: {fl_text_secondary};
    border: none;
    border-bottom: 1px solid {fl_divider};
    padding: 6px 8px;
    font-size: 12px;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QTableWidget#EnergyDailyTable {
    background: transparent;
    alternate-background-color: {fl_card_secondary};
    color: {fl_text};
    border: 1px solid {fl_card_stroke};
    border-radius: 4px;
    gridline-color: transparent;
    selection-background-color: {fl_subtle_selected};
    selection-color: {fl_text};
    padding: 0;
}

QTableWidget#EnergyDailyTable::item {
    padding: 4px 8px;
}

/* ------------------------------------------------------------ scrollbars */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px 0 2px 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    min-height: 32px;
    margin: 0 3px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background: {fl_control_strong};
    margin: 0 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0 2px 0 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    min-width: 32px;
    margin: 3px 0;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: {fl_control_strong};
    margin: 2px 0;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

/* --------------------------------------------------- flyouts and tooltips */

QToolTip {
    background: {fl_flyout};
    color: {fl_text};
    border: 1px solid {fl_flyout_stroke};
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}

QMenu {
    background: {fl_flyout};
    border: 1px solid {fl_flyout_stroke};
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    color: {fl_text};
    padding: 7px 28px 7px 12px;
    border-radius: 4px;
    margin: 0;
}

QMenu::item:selected {
    background: {fl_subtle_hover};
}

QMenu::item:pressed {
    background: {fl_control_pressed};
    color: {fl_text_secondary};
}

QMenu::item:disabled {
    color: {fl_text_disabled};
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: {fl_divider};
    margin: 4px 0;
}

QMenu::icon {
    padding-left: 10px;
}

/* ---------------------------------------------------------------- tabs */

QTabWidget::pane {
    background: {fl_card};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: {fl_text_secondary};
    padding: 0 12px;
    min-height: 36px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: {fl_text};
}

QTabBar::tab:selected {
    color: {fl_text};
    border-bottom: 2px solid {fl_accent};
}

/* --------------------------------------------------- page-specific pieces */

QFrame#MusicReactionPicker {
    background: transparent;
    border: none;
}

QFrame#AutoDirectorStatus {
    background: {fl_card_secondary};
    border: 1px solid {fl_card_stroke};
    border-radius: 8px;
}

QFrame#AutoDirectorColorDot {
    background: {fl_control};
    border: 2px solid {fl_control_strong};
    border-radius: 14px;
}

QLabel#DrawColorSwatch {
    min-width: 28px;
    min-height: 28px;
}

/* Toast surfaces are painted by the toast itself (severity colours). */
QFrame#Toast {
    background: transparent;
    border: none;
}

QLabel#ToastLabel {
    color: {fl_text};
    background: transparent;
    font-size: 14px;
}

/* -------------------------------------------------------- accounts dialog */

QListWidget#ConnectedAccounts {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget#ConnectedAccounts::item {
    padding: 0;
    margin: 0 0 4px 0;
    border: 1px solid transparent;
    border-radius: 4px;
}

QListWidget#ConnectedAccounts::item:hover {
    background: {fl_subtle_hover};
}

QListWidget#ConnectedAccounts::item:selected {
    background: {fl_subtle_selected};
    border-color: transparent;
}

QPushButton[role="accountProvider"] {
    background: transparent;
    border: 1px solid {fl_control_stroke};
    color: {fl_text_secondary};
    padding: 0 8px;
}

QPushButton[role="accountProvider"]:hover {
    background: {fl_subtle_hover};
    color: {fl_text};
}

QPushButton[role="accountProvider"]:checked {
    background: {fl_subtle_selected};
    border-color: {fl_accent};
    color: {fl_text};
}

QPushButton#AccountOptionsToggle {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    padding: 0 10px;
    color: {fl_text_secondary};
}

QPushButton#AccountOptionsToggle:checked,
QPushButton#AccountOptionsToggle:hover {
    background: {fl_subtle_hover};
    color: {fl_text};
}

QToolButton#ShowPassword {
    background: transparent;
    color: {fl_text_secondary};
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0 6px;
}

QToolButton#ShowPassword:hover {
    background: {fl_subtle_hover};
    color: {fl_text};
}

QLabel#AccountRowStatus[accountState="issue"] {
    color: {warning};
}

QLabel#AccountFeedback {
    background: {fl_card};
    color: {fl_text};
    border: 1px solid {fl_card_stroke};
    border-radius: 4px;
    padding: 12px;
}

QLabel#AccountFeedback[feedbackState="error"] {
    background: {fl_critical_bg};
}

QLabel#AccountFeedback[feedbackState="success"] {
    background: {fl_success_bg};
}

QProgressBar#AccountProgress {
    background: transparent;
    border: none;
    border-radius: 1px;
    min-height: 2px;
    max-height: 3px;
}

QProgressBar#AccountProgress::chunk {
    background: {fl_accent};
    border-radius: 1px;
}

/* ------------------------------------------------------------- energy */

QLabel[role="meterPrimary"] {
    font-family: "Segoe UI Variable Display Semibold", "Segoe UI Semibold", "Segoe UI";
    color: {fl_text};
    font-size: 36px;
    font-weight: 600;
}

QLabel[role="meterSecondary"] {
    font-family: "Segoe UI Variable Display Semibold", "Segoe UI Semibold", "Segoe UI";
    color: {fl_text};
    font-size: 20px;
    font-weight: 600;
}

QLabel[role="meterPrimary"][reported="false"],
QLabel[role="meterSecondary"][reported="false"] {
    font-family: "Segoe UI Variable Text", "Segoe UI";
    color: {fl_text_secondary};
    font-size: 14px;
    font-weight: 400;
}

QLabel[role="energyTotal"] {
    font-family: "Segoe UI Variable Display Semibold", "Segoe UI Semibold", "Segoe UI";
    color: {fl_text};
    font-size: 28px;
    font-weight: 600;
}
